{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kmarchais/trace-review/schemas/detector-rules.v1.schema.json",
  "title": "Trace Review adaptive detector rules",
  "description": "Declarative repeated-change rules. Rule IDs must also be unique, which the runtime checks separately.",
  "type": "object",
  "required": ["schemaVersion", "rules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "rules": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["id", "title", "operations"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\s*[A-Za-z0-9][A-Za-z0-9_-]*\\s*$"
          },
          "title": { "type": "string", "pattern": "\\S" },
          "minimumFiles": { "type": "integer", "minimum": 2, "maximum": 10000 },
          "operations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "required": ["side", "pattern"],
              "properties": {
                "side": { "type": "string", "enum": ["add", "delete"] },
                "pattern": { "type": "string", "pattern": "\\S", "maxLength": 1000 },
                "location": { "type": "string", "enum": ["start", "end", "any"] }
              }
            }
          }
        }
      }
    }
  }
}
